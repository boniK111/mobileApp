@model AlfaSoftWeb.Models.Client
@{ ViewData["Title"] = "Новый клиент"; }

<div class="container" style="max-width: 500px; padding: 10px;">
    <h4>Новый клиент</h4>
    <form asp-action="CreateClient" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Название</label>
            <input asp-for="name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">ИНН</label>
            <input asp-for="inn" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Телефон</label>
            <input asp-for="phone" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100 mb-2">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary w-100">Назад</a>
    </form>
</div>